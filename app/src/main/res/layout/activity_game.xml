<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- CONTENEDOR SUPERIOR CON BOTONES -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:padding="10dp">

        <ImageButton
            android:id="@+id/btnHelp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Ayuda"
            android:scaleType="fitCenter"
            android:src="@drawable/help" />

        <ImageButton
            android:id="@+id/btnPause"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_media_pause"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:scaleType="fitCenter"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="16dp"
            android:contentDescription="Pausa"
            app:tint="@color/text_primary" />

    </RelativeLayout>

    <!-- CONTENIDO CENTRAL DEL JUEGO -->
    <LinearLayout
        android:id="@+id/mainContainer"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_centerInParent="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        android:padding="30dp"
        android:background="@drawable/card_background"
        android:elevation="4dp"
        android:translationZ="2dp">

        <TextView
            android:id="@+id/txtPregunta"
            android:text="Pregunta"
            android:textColor="#333333"
            android:textSize="22sp"
            android:textStyle="bold"
            android:lineSpacingMultiplier="1.5"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
            
        <TextView
            android:id="@+id/txtPista"
            android:text="Pista: "
            android:textColor="#666666"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.2"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tu respuesta"
            app:hintTextColor="#333333"
            app:boxStrokeColor="#333333"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtRespuesta"
                android:inputType="text|numberSigned"
                android:textColor="#000000"
                android:textSize="18sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btnResponder"
            android:text="Responder"
            android:textColor="@color/white"
            android:backgroundTint="#333333"
            android:layout_marginTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            app:cornerRadius="8dp" />

        <TextView
            android:id="@+id/txtPuntuacion"
            android:text="Puntuación: 0"
            android:textColor="#333333"
            android:textSize="18sp"
            android:layout_marginTop="24dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Juego"
            android:textColor="#333333"
            android:textSize="16sp"
            android:visibility="gone" />

    </LinearLayout>

</RelativeLayout>
